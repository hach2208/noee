{
  "outputDirectory": "public",
  "buildCommand": "echo Donnees deja preparees avec npm run build",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
